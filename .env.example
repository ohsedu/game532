# game532 — 환경변수
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채우고, 같은 값을 Vercel 프로젝트 설정
# (Settings -> Environment Variables)에도 넣으세요.
#
# ★ Supabase 프로젝트는 talk532(웹톡532)와 **하나를 공유합니다.**
#
#   로그인·프로필·1:1 대화가 talk532 쪽에 있고, 이 앱의 점수 테이블
#   (game_scores)이 그 프로젝트 안에 삽니다. 스키마 정본은
#   talk532/supabase/game-scores.sql 이고, 올리는 방법은 talk532 에서
#   `npm run sql` 로 뽑은 run.sql 하나를 SQL Editor 에 붙여넣는 것입니다.
#
#   세션은 `.ohsedu.site` 쿠키에 담기므로 game / talk / login 세 호스트가
#   로그인 하나를 공유합니다. 아래 두 값이 talk532 의 것과 **같아야** 합니다 —
#   다르면 로그인은 되는데 이 앱에서는 로그아웃돼 보입니다.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable "anon" key. 노출돼도 되는 값입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. 서버 전용 — RLS 를 무시합니다. NEXT_PUBLIC_ 을 붙이지 말고,
# lib/supabase/server.ts 를 클라이언트 컴포넌트에서 import 하지 마세요.
#
# 점수를 넣는 유일한 열쇠입니다. game_scores 에는 insert 정책이 아예 없어서,
# 초당 획득량 상한과 IP 요청 제한이 있는 POST /api/scores 만 쓸 수 있습니다.
# 비어 있으면 랭킹은 보이지만 점수 등록이 503 으로 막힙니다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
#  개발에서 두 앱을 같이 띄울 때만 씁니다.
#
#  비워 두면 배포 주소(login.ohsedu.site / talk.ohsedu.site)를 가리킵니다.
#  배포된 talk532 는 localhost 로 돌려보내 주지 않으므로(열린 리다이렉터가
#  되지 않으려고), 로컬에서 로그인 흐름을 시험하려면 이 둘을 채워야 합니다.
#
#  talk532 를 3000, 이 앱을 3001 로 띄우는 것을 전제로 한 값입니다.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TALK_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_LOGIN_ORIGIN=http://localhost:3000
