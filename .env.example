# Supabase — required only for online rankings.
# The site is fully playable without these; best scores fall back to
# localStorage and the ranking page shows a "not connected" notice.
#
# Copy to .env.local for local dev, and set the same three in the Vercel
# project settings (Settings -> Environment Variables) for deployment.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable "anon" key. Safe to expose; RLS only grants it SELECT on scores.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — bypasses RLS. Never prefix this with
# NEXT_PUBLIC_, and never import lib/supabase/server.ts from a client component.
SUPABASE_SERVICE_ROLE_KEY=
